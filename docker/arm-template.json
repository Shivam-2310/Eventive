{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "containerAppName": {
      "type": "string"
    },
    "environmentName": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "dockerRegistry": {
      "type": "string"
    },
    "dockerUsername": {
      "type": "string"
    },
    "dockerPassword": {
      "type": "securestring"
    },
    "imageName": {
      "type": "string"
    },
    "imageTag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Immutable image tag (typically the CI commit short SHA). Using a unique tag per deploy forces Container Apps to create a new revision and pull the new image — pointing at ':latest' makes ACA treat identical deploys as no-ops."
      }
    },
    "geminiApiKey": {
      "type": "securestring",
      "defaultValue": ""
    },
    "groqApiKey": {
      "type": "securestring",
      "defaultValue": ""
    },
    "jwtSecret": {
      "type": "securestring",
      "defaultValue": "change-me-in-ci"
    },
    "adminEmail": {
      "type": "string",
      "defaultValue": "admin@eventive.dev"
    },
    "adminInitialPassword": {
      "type": "securestring",
      "defaultValue": "admin"
    },
    "mediaSigningSecret": {
      "type": "securestring",
      "defaultValue": "dev-media-secret",
      "metadata": {
        "description": "HMAC secret for signed /media/blob URLs. Must match the secret in effect when the shipped eventive.db was generated (defaults to `dev-media-secret`, which is also the built-in Settings default)."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 80,
            "allowInsecure": false,
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          },
          "registries": [
            {
              "server": "[parameters('dockerRegistry')]",
              "username": "[parameters('dockerUsername')]",
              "passwordSecretRef": "registry-password"
            }
          ],
          "secrets": [
            {
              "name": "registry-password",
              "value": "[parameters('dockerPassword')]"
            },
            {
              "name": "gemini-api-key",
              "value": "[parameters('geminiApiKey')]"
            },
            {
              "name": "groq-api-key",
              "value": "[parameters('groqApiKey')]"
            },
            {
              "name": "jwt-secret",
              "value": "[parameters('jwtSecret')]"
            },
            {
              "name": "admin-initial-password",
              "value": "[parameters('adminInitialPassword')]"
            },
            {
              "name": "media-signing-secret",
              "value": "[parameters('mediaSigningSecret')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "[parameters('containerAppName')]",
              "image": "[concat(parameters('imageName'), ':', parameters('imageTag'))]",
              "resources": {
                "cpu": 0.5,
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "DATA_DIR",
                  "value": "/data"
                },
                {
                  "name": "LLM_PROVIDER",
                  "value": "gemini"
                },
                {
                  "name": "GEMINI_API_KEY",
                  "secretRef": "gemini-api-key"
                },
                {
                  "name": "GROQ_API_KEY",
                  "secretRef": "groq-api-key"
                },
                {
                  "name": "JWT_SECRET",
                  "secretRef": "jwt-secret"
                },
                {
                  "name": "ADMIN_EMAIL",
                  "value": "[parameters('adminEmail')]"
                },
                {
                  "name": "ADMIN_INITIAL_PASSWORD",
                  "secretRef": "admin-initial-password"
                },
                {
                  "name": "MEDIA_SIGNING_SECRET",
                  "secretRef": "media-signing-secret"
                },
                {
                  "name": "CORS_ORIGINS",
                  "value": "*"
                }
              ],
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/healthz",
                    "port": 80
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 20
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/healthz",
                    "port": 80
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 30
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 1
          }
        }
      }
    }
  ],
  "outputs": {
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2023-05-01', 'Full').properties.configuration.ingress.fqdn]"
    }
  }
}
