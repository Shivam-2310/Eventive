# --- runtime ---
DATABASE_URL=sqlite:///./data/flo.db
DATA_DIR=./data
PORT=8000

# --- Chat LLM (Ask Flo agent / NL2SQL / recommendation reasons) ---
# The LangChain Ask Flo agent in app/domain/ai/agent.py picks its provider
# in this priority order regardless of LLM_PROVIDER:
#   Groq (if GROQ_API_KEY is set)  ← recommended for demo, free 30 rpm
#   Gemini (if GEMINI_API_KEY is set)
#   Deterministic regex fallback   ← if neither key is configured
# LLM_PROVIDER only affects the legacy stub_provider paths (kept for tests).
LLM_PROVIDER=stub

# Groq (primary) — https://console.groq.com — free tier is generous.
# llama-3.1-8b-instant: 500K TPD, 14.4K RPD, native tool-calling, fast.
# Bump to llama-3.3-70b-versatile if the 8B answers feel too thin (100K TPD).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (fallback) — free tier is 5 req/min per model and will 429 quickly.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# --- Embeddings (always local by default — no network, no quotas) ---
# local | stub
EMBED_PROVIDER=local
# Any fastembed-supported model. bge-small-en-v1.5 is 384-dim and ~50 MB on
# disk; must match EMBED_DIM in app/domain/ai/llm_provider.py and the vec_*
# table dimension in Alembic 004_local_embeddings.
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- CORS (comma-separated). "*" ok in dev, locked in Phase 14. ---
CORS_ORIGINS=*

# --- Auth (Phase 14, not enforced yet) ---
JWT_SECRET=dev-only-not-a-real-secret
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# --- Admin bootstrap (Phase 14) ---
ADMIN_EMAIL=admin@flo.dev
ADMIN_INITIAL_PASSWORD=admin

# --- Media signing ---
MEDIA_SIGNING_SECRET=dev-media-secret
MEDIA_URL_TTL_SECONDS=600

# --- Seeder toggles ---
SEED_DEMO_FIXTURES=true

# --- Frontend hosting ---
# Absolute path to a built Flutter web bundle (index.html + assets). Leave blank
# for backend-only mode (Flutter dev server runs separately on port 3000).
# In the Docker image this is set to /app/frontend_web by the Dockerfile.
FRONTEND_WEB_DIR=
